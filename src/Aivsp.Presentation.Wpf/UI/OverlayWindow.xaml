<Window x:Class="Aivsp.Presentation.Wpf.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIVSP Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Canvas Name="MainCanvas" Background="Transparent">
        <Border x:Name="IndicatorBorder"
                BorderBrush="LimeGreen"
                BorderThickness="8"
                Background="#40FF0000"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="LimeGreen" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
            </Border.Effect>
        </Border>
        
        <Border x:Name="SuggestionBorder"
                Background="#D9000000"
                BorderBrush="DeepSkyBlue"
                BorderThickness="2"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="8"
                Padding="15"
                MaxWidth="500"
                MaxHeight="250">
            <Border.Effect>
                <DropShadowEffect Color="DeepSkyBlue" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <TextBlock x:Name="SuggestionText"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Normal"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Canvas>
</Window>
