<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aivsp.Application\Aivsp.Application.csproj" />
    <ProjectReference Include="..\Aivsp.Infrastructure.Windows\Aivsp.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\Aivsp.Infrastructure.Inference\Aivsp.Infrastructure.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Aivsp.Infrastructure.Inference\Assets\gemini-aivsp-system.md"
             Link="gemini-aivsp-system.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Aivsp.Infrastructure.Inference\Assets\gemini-aivsp-policy.toml"
             Link="gemini-aivsp-policy.toml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Aivsp.Infrastructure.Inference\Assets\gemini-aivsp-settings.json"
             Link="gemini-aivsp-settings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Version>0.2.0-beta.2</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.2</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
